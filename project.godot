; Engine configuration file.
config_version=5

[application]

config/name="Gu-Weltenbox"
config/description="God-Simulator im WorldBox-Stil in der Welt von Reverend Insanity"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=400
window/size/viewport_height=880
window/size/window_width_override=450
window/size/window_height_override=990
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

